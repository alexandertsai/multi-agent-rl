{
  "preset": "single",
  "config": {
    "n_agents": 1,
    "tools": false,
    "max_turns": 50,
    "max_turn_tokens": 12000,
    "max_context": 48000,
    "max_wait_seconds": 120.0,
    "team_weight": 0.8,
    "own_weight": 0.2,
    "rush_penalty": 0.2
  },
  "steps": 115,
  "puzzles_per_step": 16,
  "groups": 16,
  "lr": 1e-05,
  "max_grad_norm": 1.0,
  "tis_cap": 2.0,
  "norm_tokens": 8192,
  "eval_every": 10,
  "eval_limit": 100,
  "eval_samples": 4,
  "ckpt_every": 5,
  "servers": "http://127.0.0.1:8000,http://127.0.0.1:8001",
  "served_model": "Qwen3.8-Flash-Next",
  "concurrency": 256,
  "model_dir": "models/Qwen3.8-Flash-Next",
  "train_data": "data/train.jsonl",
  "eval_data": "data/heldout.jsonl",
  "seed": 0,
  "out": "runs/rl-single"
}
